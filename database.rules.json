{
  "rules": {
    ".read": "auth != null && auth.uid === 'REPLACE_WITH_TEACHER_UID'",
    ".write": "auth != null && auth.uid === 'REPLACE_WITH_TEACHER_UID'",

    "pub": {
      "$token": {
        "state": { ".read": "auth != null" },
        "msg": { ".read": "auth != null" },
        "private": {
          "$sid": { ".read": "auth != null" }
        },

        "quiz": {
          "live": { ".read": "auth != null" },
          "players": {
            ".read": "auth != null",
            "$sid": {
              ".write": "auth != null && !data.exists() && newData.exists() && root.child('pub').child($token).child('quiz/live/status').exists() && root.child('pub').child($token).child('quiz/live/status').val() !== 'done'",
              ".validate": "newData.hasChildren(['name', 'uid', 'ts']) && $sid.matches(/^s[0-9a-z]{1,12}$/)",
              "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
              "uid":  { ".validate": "newData.isString() && newData.val() === auth.uid" },
              "ts":   { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "answers": {
            "$qk": {
              "$sid": {
                ".write": "auth != null && !data.exists() && newData.exists() && root.child('pub').child($token).child('quiz/players').child($sid).child('uid').val() === auth.uid && root.child('pub').child($token).child('quiz/live/status').val() === 'q' && root.child('pub').child($token).child('quiz/live/qk').val() === $qk && now <= root.child('pub').child($token).child('quiz/live/endsAt').val() + 2000",
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
              }
            }
          }
        },

        "joined": {
          "$sid": {
            ".write": "auth != null && root.child('pub').child($token).child('state').exists()",
            ".validate": "newData.isBoolean() && $sid.matches(/^s[0-9a-z]{1,12}$/)"
          }
        },

        "orders": {
          "$oid": {
            ".write": "auth != null && !data.exists() && newData.exists() && root.child('pub').child($token).child('state').exists()",
            ".validate": "newData.hasChildren(['kind', 'sid', 'round', 'ts'])",
            "kind":   { ".validate": "newData.isString() && newData.val().matches(/^(buy|sell|news)$/)" },
            "sid":    { ".validate": "newData.isString() && newData.val().matches(/^s[0-9a-z]{1,12}$/)" },
            "round":  { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99" },
            "ts":     { ".validate": "newData.isNumber()" },
            "s":      { ".validate": "newData.isString() && newData.val().matches(/^(FOOD|LOGI|MED|GAME|EV)$/)" },
            "tier":   { ".validate": "newData.isString() && newData.val().matches(/^(disc|news|rumor)$/)" },
            "qty":    { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000" },
            "reason": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
